{% if privacyConsentEnabled %}
  <div
    id="privacyConsentDialog"
    tabindex="-1"
    role="dialog"
    aria-labelledby="privacyConsentDialogTitle"
    data-role="privacy_consent_dialog"
    data-backdrop="false"
    data-consent-dialog-show="{{ privacyConsentDialogShow ? 'true' : 'false' }}"
    {% if not privacyConsentDialogShow %}
      style="display: none"
    {% endif %}
  >
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <form data-role="privacy_consent_dialog_form">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'lbl.Close'|trans }}">
              <span aria-hidden="true">&times;</span>
            </button>
            <h5 id="privacyConsentDialogTitle">{{ 'msg.PrivacyConsentDialogTitle'|trans|raw }}</h5>
          </div>
          <div class="modal-body">
            <div>
              {{ 'msg.PrivacyConsentDialogBefore'|trans|raw }}
            </div>

            <div class="checkbox">
              <label id="privacyConsentLevelFunctionalityStorageCheckbox">
                <input name="privacyConsentLevelFunctionalityStorageCheckbox" id="privacyConsentLevelFunctionalityStorageCheckbox"
                       type="checkbox" checked disabled aria-describedby="privacyConsentLevelFunctionalityStorageHelpBlock"
                       data-role="privacy-level"
                       data-value="functionality_storage"
                >
                {{ 'msg.PrivacyConsentLevelFunctionalityStorageTitle'|trans|raw }}
              </label>
              <small id="privacyConsentLevelFunctionalityStorageHelpBlock" class="help-block">
                {{ 'msg.PrivacyConsentLevelFunctionalityStorageText'|trans|raw }}
              </small>
            </div>
            <div class="checkbox">
              <label id="privacyConsentLevelSecurityStorageCheckbox">
                <input name="privacyConsentLevelSecurityStorageCheckbox" id="privacyConsentLevelSecurityStorageCheckbox"
                       type="checkbox" checked disabled aria-describedby="privacyConsentLevelSecurityStorageHelpBlock"
                       data-role="privacy-level"
                       data-value="security_storage"
                >
                {{ 'msg.PrivacyConsentLevelSecurityStorageTitle'|trans|raw }}
              </label>
              <small id="privacyConsentLevelSecurityStorageHelpBlock" class="help-block">
                {{ 'msg.PrivacyConsentLevelSecurityStorageText'|trans|raw }}
              </small>
            </div>
            {% for level in privacyConsentDialogLevels %}
              <div class="checkbox">
                <label id="privacyConsentLevel{{ level.localeKey }}Checkbox">
                  <input name="privacyConsentLevel{{ level.localeKey }}Checkbox"
                         id="privacyConsentLevel{{ level.localeKey }}Checkbox" type="checkbox"
                         aria-describedby="privacyConsentLevel{{ level.localeKey }}HelpBlock"
                         data-role="privacy-level"
                         data-value="{{ level.name }}"
                  >
                  {{ ('msg.PrivacyConsentLevel' ~ level.localeKey ~ 'Title')|trans|raw }}
                </label>
                <small id="privacyConsentLevel{{ level.localeKey }}HelpBlock" class="help-block">
                  {{ ('msg.PrivacyConsentLevel' ~ level.localeKey ~ 'Text')|trans|raw }}
                </small>
              </div>
            {% endfor %}

            <div>
              {{ 'msg.PrivacyConsentDialogAfter'|trans|raw }}
            </div>
          </div>
          <div class="modal-footer">
            <button type="submit" data-role="privacy_consent_dialog_save_button" class="btn btn-sm btn-success">
              {{ 'msg.PrivacyConsentDialogSave'|trans }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endif %}
