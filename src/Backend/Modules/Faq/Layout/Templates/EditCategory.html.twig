{% extends 'Layout/Templates/base.html.twig' %}
{% import 'Layout/Templates/macros.html.twig' as macro %}

{% block actionbar %}{% endblock %}

{% block content %}
  {{ form_start(form) }}
  <div class="fork-module-content">
    <div role="tabpanel">
      <ul class="nav nav-tabs nav-tabs-flex" role="tablist">
        <li role="presentation" class="active mr-auto">
          <a href="#tabContent" aria-controls="tabContent" role="tab" data-toggle="tab">{{ 'lbl.Content'|trans|ucfirst }}</a>
        </li>
        <li role="presentation" class="pull-right">
          <a href="#tabSEO" aria-controls="tabSEO" role="tab" data-toggle="tab">{{ 'lbl.SEO'|trans|ucfirst }}</a>
        </li>
      </ul>
      <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="tabSEO">
          <div class="row fork-module-content">
            <ul class="nav nav-tabs" role="tablist">
              {% for locale, translationField in form.translations %}
                {% set tabName = 'tabSEO' ~ locale|ucfirst %}
                <li role="presentation"{% if loop.first %} class="active"{% endif %}>
                  <a href="#{{ tabName }}" aria-controls="{{ tabName }}" role="tab" data-toggle="tab">{{ locale|upper|tolabel|ucfirst }}</a>
                </li>
              {% endfor %}
            </ul>
            <div class="tab-content">
              {% for locale, translationField in form.translations %}
                {% set tabName = 'tabSEO' ~ locale|ucfirst %}
                <div role="tabpanel" class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabName }}">
                  <div class="row">
                    {{ form_widget(translationField.meta) }}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div role="tabpanel" class="tab-pane active" id="tabContent">
          <div role="tabpanel">
            <ul class="nav nav-tabs" role="tablist">
              {% for locale, translationField in form.translations %}
                {% set tabName = 'tab' ~ locale|ucfirst %}
                <li role="presentation"{% if activeTranslationTab == tabName %} class="active"{% endif %}>
                  <a href="#{{ tabName }}" aria-controls="{{ tabName }}" role="tab" data-toggle="tab">{{ locale|upper|tolabel|ucfirst }}</a>
                </li>
              {% endfor %}
            </ul>
            <div class="tab-content">
              {% for locale, translationField in form.translations %}
                {% set tabName = 'tab' ~ locale|ucfirst %}
                <div role="tabpanel" class="tab-pane{% if activeTranslationTab == tabName %} active{% endif %}" id="{{ tabName }}">
                  <div class="form-group">
                    {{ form_label(translationField.title) }}
                    {{ form_widget(translationField.title) }}
                    {{ form_errors(translationField.title) }}
                  </div>
                  {% if detailURL %}
                    <a class="site-url" href="{{ detailURL }}">{{ detailURL }}/<span id="generatedUrl-{{ locale }}">{{ translationField.meta.vars.value.url ?? '' }}</span></a>
                  {% else %}
                    <p class="alert alert-warning alert-xs">{{ macro.icon('exclamation-triangle') }}{{ 'err.NoModuleLinked'|trans|ucfirst }}</p>
                  {% endif %}
                  {{ form_rest(translationField) }}
                </div>
              {% endfor %}
            </div>
          </div>
          {{ form_rest(form) }}
        </div>
      </div>
    </div>
  </div>

  <div class="row fork-page-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group pull-left" role="group">
          {% if showFaqDeleteCategory and isAllowedAction('DeleteCategory') %}
            {{ macro.buttonIcon('', 'trash-o', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"button", "data-toggle":"modal", "data-target":"#confirmDelete" }) }}
          {% endif %}
          {{ macro.buttonIcon(backLink ?? geturl('Categories'), 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-default') }}
        </div>
        <div class="btn-group pull-right" role="group">
          {{ macro.buttonIcon('', 'check', 'lbl.Save'|trans|ucfirst, 'btn-primary', { "type":"submit", "id":"editButton", "name":"edit" }) }}
        </div>
      </div>
    </div>
  </div>
  {{ form_end(form) }}

  {% if showFaqDeleteCategory and isAllowedAction('DeleteCategory') %}
    {{ form_start(deleteForm) }}
    {{ form_row(deleteForm._token) }}
    {{ form_row(deleteForm.id) }}
    <div class="modal fade" id="confirmDelete" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="confirmDeleteTitle">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="confirmDeleteTitle">{{ 'lbl.Delete'|trans|ucfirst }}</h4>
          </div>
          <div class="modal-body">
            <p>{{ 'msg.ConfirmDeleteCategory'|trans|format(faqCategory.getTranslation(locale).title|e)|raw }}</p>
          </div>
          <div class="modal-footer">
            {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-default', { "data-dismiss":"modal", "type":"button" }) }}
            {{ macro.buttonIcon('', 'trash', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"submit" }) }}
          </div>
        </div>
      </div>
    </div>
    {{ form_end(deleteForm) }}
  {% endif %}
{% endblock %}
