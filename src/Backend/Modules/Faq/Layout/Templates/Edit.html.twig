{% extends 'Layout/Templates/base.html.twig' %}
{% import 'Layout/Templates/macros.html.twig' as macro %}

{% block actionbar %}{% endblock %}

{% block content %}
  {{ form_start(form) }}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div role="tabpanel">
        <ul class="nav nav-tabs nav-tabs-flex" role="tablist">
          <li role="presentation" class="active mr-auto">
            <a href="#tabContent" aria-controls="tabContent" role="tab" data-toggle="tab">{{ 'lbl.Content'|trans|ucfirst }}</a>
          </li>
          <li role="presentation">
            <a href="#tabFeedback" aria-controls="tabFeedback" role="tab" data-toggle="tab">
              {{ 'lbl.Feedback'|trans|ucfirst }}
              <span class="label label-success">{{ faqQuestion.numUsefulYes }}</span>
              <span class="label label-danger">{{ faqQuestion.numUsefulNo }}</span>
            </a>
          </li>
          <li role="presentation" class="pull-right">
            <a href="#tabSEO" aria-controls="tabSEO" role="tab" data-toggle="tab">{{ 'lbl.SEO'|trans|ucfirst }}</a>
          </li>
        </ul>
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane" id="tabSEO">
            <div class="row fork-module-content">
              <ul class="nav nav-tabs" role="tablist">
                {% for locale, translationField in form.translations %}
                  {% set tabName = 'tabSEO' ~ locale|ucfirst %}
                  <li role="presentation"{% if loop.first %} class="active"{% endif %}>
                    <a href="#{{ tabName }}" aria-controls="{{ tabName }}" role="tab" data-toggle="tab">{{ locale|upper|tolabel|ucfirst }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for locale, translationField in form.translations %}
                  {% set tabName = 'tabSEO' ~ locale|ucfirst %}
                  <div role="tabpanel" class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabName }}">
                    <div class="row">{{ form_widget(translationField.meta) }}</div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div role="tabpanel" class="tab-pane active" id="tabContent">
            <div class="row">
              <div class="col-md-8">
                <ul class="nav nav-tabs" role="tablist">
                  {% for locale, translationField in form.translations %}
                    {% set tabName = 'tab' ~ locale|ucfirst %}
                    <li role="presentation"{% if activeTranslationTab == tabName %} class="active"{% endif %}>
                      <a href="#{{ tabName }}" aria-controls="{{ tabName }}" role="tab" data-toggle="tab">{{ locale|upper|tolabel|ucfirst }}</a>
                    </li>
                  {% endfor %}
                </ul>
                <div class="tab-content">
                  {% for locale, translationField in form.translations %}
                    {% set tabName = 'tab' ~ locale|ucfirst %}
                    <div role="tabpanel" class="tab-pane{% if activeTranslationTab == tabName %} active{% endif %}" id="{{ tabName }}">
                      <div class="form-group">
                        {{ form_label(translationField.question) }}
                        {{ form_widget(translationField.question) }}
                        {{ form_errors(translationField.question) }}
                        {% if detailURL %}
                          <a class="site-url" href="{{ detailURL }}">{{ detailURL }}/<span id="generatedUrl-{{ locale }}">{{ translationField.meta.vars.value.url ?? '' }}</span></a>
                        {% else %}
                          <p class="alert alert-warning alert-xs">{{ macro.icon('exclamation-triangle') }}{{ 'err.NoModuleLinked'|trans|ucfirst }}</p>
                        {% endif %}
                      </div>
                      <div class="panel panel-default panel-editor optionsRTE">
                        <div class="panel-heading">
                          {{ form_label(translationField.answer) }}
                        </div>
                        <div class="panel-body">
                          {{ form_widget(translationField.answer) }}
                        </div>
                        {{ form_errors(translationField.answer) }}
                      </div>
                      {{ form_rest(translationField) }}
                    </div>
                  {% endfor %}
                </div>
              </div>

              <div class="col-md-4">
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h2 class="panel-title">{{ 'lbl.Status'|trans|ucfirst }}</h2>
                  </div>
                  <div class="panel-body">
                    <div class="form-group last">
                      {{ form_label(form.hidden) }}
                      {{ form_widget(form.hidden) }}
                    </div>
                  </div>
                </div>
                <div class="panel panel-default last">
                  <div class="panel-heading">
                    <h2 class="panel-title">{{ 'lbl.MetaData'|trans|ucfirst }}</h2>
                  </div>
                  <div class="panel-body">
                    <div class="form-group">
                      {{ form_row(form.category, {'label': 'lbl.Category'|trans|ucfirst}) }}
                    </div>
                    {% if tagsEnabled %}
                    <div class="form-group last">
                      {{ form_row(form.tags, {'label': 'lbl.Tags'|trans|ucfirst}) }}
                      <div class="help-block">{{ 'msg.HelpTextTags'|trans }}</div>
                    </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
            {{ form_rest(form) }}
          </div>

          <div role="tabpanel" class="tab-pane" id="tabFeedback">
            <div class="row">
              <div class="col-md-12">
                <div class="content-title">
                  <h2>{{ 'lbl.Feedback'|trans|ucfirst }}</h2>
                  <p class="help-block">{{ 'msg.FeedbackInfo'|trans }}</p>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                {% if feedback %}
                  <div class="panel-group" id="feedback" role="tablist" aria-multiselectable="false">
                    {% for item in feedback %}
                      <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="feedback-heading-{{ item.id }}">
                          <h4 class="panel-title">
                            <a data-toggle="collapse" data-parent="#feedback" href="#feedback-collapse-{{ item.id }}" aria-expanded="true" aria-controls="feedback-collapse-{{ item.id }}">
                              {{ macro.icon('caret-right fa-fw') }}{{ item.text|truncate(150) }}
                            </a>
                          </h4>
                        </div>
                        <div id="feedback-collapse-{{ item.id }}" class="panel-collapse collapse" role="tabpanel" aria-labelledby="feedback-heading-{{ item.id }}">
                          <div class="panel-body">{{ item.text }}</div>
                          {% if isAllowedAction('DeleteFeedback') %}
                            <div class="panel-footer">
                              <div class="btn-toolbar">
                                <div class="btn-group pull-left" role="group">
                                  {{ macro.buttonIcon('#', 'trash-o', 'lbl.Delete'|trans|ucfirst, 'btn-danger', 'data-id=' ~ item.id ~ ' data-role=delete-feedback') }}
                                </div>
                              </div>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <p>{{ 'msg.NoFeedbackItems'|trans }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row fork-page-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group pull-left" role="group">
          {% if isAllowedAction('Delete') %}
            {{ macro.buttonIcon('', 'trash-o', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"button", "data-toggle":"modal", "data-target":"#confirmDelete" }) }}
          {% endif %}
          {{ macro.buttonIcon(backLink ?? geturl('Index'), 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-default') }}
        </div>
        <div class="btn-group pull-right" role="group">
          {{ macro.buttonIcon('', 'check', 'lbl.Save'|trans|ucfirst, 'btn-primary', { "type":"submit", "id":"editButton", "name":"edit" }) }}
        </div>
      </div>
    </div>
  </div>
  {{ form_end(form) }}

  {% if isAllowedAction('Delete') %}
    {{ form_start(deleteForm) }}
    {{ form_row(deleteForm._token) }}
    {{ form_row(deleteForm.id) }}
    <div class="modal fade" id="confirmDelete" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="confirmDeleteTitle">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="confirmDeleteTitle">{{ 'lbl.Delete'|trans|ucfirst }}</h4>
          </div>
          <div class="modal-body">
            <p>{{ 'msg.ConfirmDelete'|trans|format(faqQuestion.getTranslation(locale).question|e)|raw }}</p>
          </div>
          <div class="modal-footer">
            {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-default', { "data-dismiss":"modal", "type":"button" }) }}
            {{ macro.buttonIcon('', 'trash', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"submit" }) }}
          </div>
        </div>
      </div>
    </div>
    {{ form_end(deleteForm) }}
  {% endif %}

  {% if isAllowedAction('DeleteFeedback') %}
    {{ form_start(deleteFeedbackForm) }}
    {{ form_row(deleteFeedbackForm._token) }}
    {{ form_row(deleteFeedbackForm.id) }}
    <div class="modal fade" id="confirmDeleteFeedback" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="confirmDeleteFeedbackTitle">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="confirmDeleteFeedbackTitle">{{ 'lbl.Delete'|trans|ucfirst }}</h4>
          </div>
          <div class="modal-body">
            <p>{{ 'msg.ConfirmDeleteFeedback'|trans|raw }}</p>
          </div>
          <div class="modal-footer">
            {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-default', { "data-dismiss":"modal", "type":"button" }) }}
            {{ macro.buttonIcon('', 'trash', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"submit" }) }}
          </div>
        </div>
      </div>
    </div>
    {{ form_end(deleteFeedbackForm) }}
  {% endif %}
{% endblock %}

