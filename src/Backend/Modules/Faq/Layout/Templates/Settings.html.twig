{% extends 'Layout/Templates/base.html.twig' %}
{% import 'Layout/Templates/macros.html.twig' as macro %}

{% block content %}
  {{ form_start(form) }}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h2 class="panel-title">{{ 'lbl.Pagination'|trans|ucfirst }}</h2>
        </div>
        <div class="panel-body">
          {{ form_row(form.overviewNumItemsPerCategory, {'label': 'lbl.ItemsPerCategory'|trans|ucfirst}) }}
          {{ form_row(form.mostReadNumItems, {'label': 'msg.NumMostReadItems'|trans}) }}
          {{ form_row(form.relatedNumItems, {'label': 'msg.NumRelatedItems'|trans}) }}
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h2 class="panel-title">{{ 'lbl.Categories'|trans|ucfirst }}</h2>
        </div>
        <div class="panel-body">
          <div class="form-group last">
            <ul class="list-unstyled">
              <li class="checkbox">
                <label>
                  {{ form_widget(form.allowMultipleCategories) }} {{ 'lbl.AllowMultipleCategories'|trans|ucfirst }}
                </label>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h2 class="panel-title">{{ 'lbl.Feedback'|trans|ucfirst }}</h2>
        </div>
        <div class="panel-body">
          <div class="form-group last">
            <ul class="list-unstyled">
              <li class="checkbox">
                <label>
                  {{ form_widget(form.allowFeedback) }} {{ 'lbl.AllowFeedback'|trans|ucfirst }}
                </label>
              </li>
              <li class="checkbox">
                <label>
                  {{ form_widget(form.allowOwnQuestion) }} {{ 'lbl.AllowOwnQuestion'|trans|ucfirst }}
                </label>
              </li>
              <li class="checkbox">
                <label>
                  {{ form_widget(form.sendEmailOnNewFeedback) }} {{ 'lbl.SendEmailOnNewFeedback'|trans|ucfirst }}
                </label>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{ form_rest(form) }}
  <div class="row fork-module-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group pull-right" role="group">
          {{ macro.buttonIcon('', 'floppy-o', 'lbl.Save'|trans|ucfirst, 'btn-primary', { "type":"submit", "id":"save", "name":"save" }) }}
        </div>
      </div>
    </div>
  </div>
  {{ form_end(form) }}
{% endblock %}
